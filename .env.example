# Example only. Set a strong password in your runtime environment.
# Never commit real credentials to GitHub.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_image_detector
DB_USER=ai_image_app
DB_PASSWORD=replace-with-a-long-random-password

# Local Smaug detector runs by default without an API token.
ENABLE_LOCAL_CLASSIFIER=true
SMAUG_MODEL_ID=abacusai/Smaug-AI-Image-Detector
SMAUG_NUM_THREADS=4
SMAUG_TIMEOUT_SECONDS=300
# Optional immutable Hugging Face revision pin. Set after reviewing a model commit.
SMAUG_MODEL_REVISION=

# External provenance remains disabled until privacy/access approval.
ENABLE_EXTERNAL_PROVENANCE=false
OPENAI_API_KEY=
