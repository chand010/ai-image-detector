# Example only. Copy to .env on your own computer and set a strong password.
# Never put real credentials in GitHub.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_image_detector
DB_USER=ai_image_app
DB_PASSWORD=replace-with-a-long-random-password

# External provenance processing stays disabled until privacy/access approval.
ENABLE_EXTERNAL_PROVENANCE=false
# Leave blank unless the provider is approved and configured at runtime.
OPENAI_API_KEY=
